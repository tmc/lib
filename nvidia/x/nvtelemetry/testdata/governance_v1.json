{
  "version": 1,
  "source_id": "fixture-nvml",
  "allowed_devices": ["GPU-0"],
  "max_readings": 32,
  "max_sample_bytes": 4096,
  "collector": {
    "interval_nanos": 1000000,
    "max_duration_nanos": 1000000000,
    "max_record_budget": 20,
    "max_byte_budget": 32768,
    "max_buffered_records": 4,
    "budget_policy": "drop",
    "drop_on_full": true
  }
}
