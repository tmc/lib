// Feature: mbarriertx -- mbarrier with a transaction byte count, a
// cluster-scope arrive and a parity try_wait: the forms a TMA pipeline
// waits with. The plain arrive/wait barrier is probed as mbarrier.
.version 9.0
.target TARGET
.address_size 64
.visible .entry probe(.param .u64 bar)
{
  .reg .b64 %rd<3>;
  .reg .b32 %r<2>;
  .reg .pred %p<2>;
  ld.param.u64 %rd1, [bar];
  cvta.to.shared.u64 %rd1, %rd1;
  mov.u32 %r1, 1024;
  mbarrier.init.shared::cta.b64 [%rd1], 128;
  mbarrier.expect_tx.relaxed.cta.shared::cta.b64 [%rd1], %r1;
  mbarrier.arrive.expect_tx.release.cluster.shared::cta.b64 %rd2, [%rd1], %r1;
  mbarrier.try_wait.parity.shared::cta.b64 %p1, [%rd1], 0;
  ret;
}
