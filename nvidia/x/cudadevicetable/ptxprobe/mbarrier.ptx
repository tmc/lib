// Feature: mbarrier -- shared-memory arrive/wait barrier, the sm_80 form.
// The transaction-count and cluster-scope forms a TMA pipeline needs are
// probed separately, as mbarriertx.
.version 9.0
.target TARGET
.address_size 64
.visible .entry probe(.param .u64 bar)
{
  .reg .b64 %rd<3>;
  .reg .pred %p<2>;
  ld.param.u64 %rd1, [bar];
  cvta.to.shared.u64 %rd1, %rd1;
  mbarrier.init.shared.b64 [%rd1], 128;
  mbarrier.arrive.shared.b64 %rd2, [%rd1];
  mbarrier.test_wait.shared.b64 %p1, [%rd1], %rd2;
  ret;
}
