// Feature: mmasync -- warp-level BF16 tensor core MMA (mma.sync m16n8k16),
// the instruction the generator's tile gemms use on every target.
.version 9.0
.target TARGET
.address_size 64
.visible .entry probe(.param .u64 p)
{
  .reg .b32 %r<7>;
  .reg .f32 %f<5>;
  .reg .b64 %rd<2>;
  ld.param.u64 %rd1, [p];
  ld.global.v4.b32 {%r1,%r2,%r3,%r4}, [%rd1];
  ld.global.v2.b32 {%r5,%r6}, [%rd1+16];
  mov.f32 %f1, 0f00000000;
  mov.f32 %f2, 0f00000000;
  mov.f32 %f3, 0f00000000;
  mov.f32 %f4, 0f00000000;
  mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32 {%f1,%f2,%f3,%f4}, {%r1,%r2,%r3,%r4}, {%r5,%r6}, {%f1,%f2,%f3,%f4};
  st.global.v4.f32 [%rd1], {%f1,%f2,%f3,%f4};
  ret;
}
