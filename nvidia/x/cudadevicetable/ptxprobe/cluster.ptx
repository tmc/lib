// Feature: cluster -- thread block clusters.
.version 9.0
.target TARGET
.address_size 64
.visible .entry probe(.param .u64 p)
{
  .reg .b64 %rd<2>;
  .reg .b32 %r<2>;
  ld.param.u64 %rd1, [p];
  barrier.cluster.arrive;
  barrier.cluster.wait;
  mov.u32 %r1, %cluster_ctarank;
  st.global.u32 [%rd1], %r1;
  ret;
}
