+#ifndef NCCL_PROGRESS_MONITOR_EXPORT_H_
+#define NCCL_PROGRESS_MONITOR_EXPORT_H_
+
+// Pure diagnostic state and JSONL encoding. No CUDA, file or thread operations.
+// The monitor owns serialization and communicator lifetimes under its mutex.
+#include <cstddef>
+#include <cstdint>
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+
+namespace ncclProgressExport {
+static constexpr size_t Slots = 16;
+static constexpr size_t Channels = 64;
+static constexpr size_t MaxComms = 128;
+static constexpr size_t MaxLine = 16384;
+static constexpr uint64_t MaxRecords = 4096;
+static constexpr uint64_t MaxBytes = 16 * 1024 * 1024;
+
+struct Identity {
+  char host[129] = {};
+  char boot[129] = {};
+  char process[129] = {};
+  char capture[129] = {};
+  char build[129] = {};
+  uint64_t pid = 0;
+  uint64_t worker = 0;
+  int device = -1;
+  int pollMs = 0;
+  int staleMs = 0;
+};
+
+inline bool copyToken(char (&to)[129], const char* from) {
+  if (from == nullptr) return false;
+  size_t n = 0;
+  for (; from[n] != 0 && n < sizeof(to); n++) {
+    char c = from[n];
+    if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+          (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.' || c == ':')) return false;
+  }
+  if (n == 0 || n >= sizeof(to)) return false;
+  std::memcpy(to, from, n + 1);
+  return true;
+}
+
+struct Snapshot {
+  uint64_t counts[Slots] = {};
+  uint64_t gpuTimes[Slots] = {};
+  uint64_t active[Channels] = {};
+};
+
+struct Entry {
+  const void* key = nullptr; // compared only; never dereferenced or exported
+  uint64_t comm = 0;
+  int rank = -1;
+  uint64_t incarnation = 0; // this monitor registration, not application membership
+  uint64_t generation = 0;
+  uint64_t launchStart = 0;
+  uint64_t launchEnd = 0;
+  int launchCode = 0;
+  bool pending = false;
+  bool eventRecorded = false;
+  bool stale = false;
+};
+
+class Line {
+ public:
+  char data[MaxLine];
+  size_t size = 0;
+  bool ok = true;
+  void append(const char* format, ...) {
+    if (!ok) return;
+    va_list args;
+    va_start(args, format);
+    int n = std::vsnprintf(data + size, sizeof(data) - size, format, args);
+    va_end(args);
+    if (n < 0 || static_cast<size_t>(n) >= sizeof(data) - size) {
+      ok = false;
+      return;
+    }
+    size += static_cast<size_t>(n);
+  }
+  void array(const uint64_t* values, size_t n) {
+    append("[");
+    for (size_t i = 0; i < n; i++) append("%s%llu", i == 0 ? "" : ",", (unsigned long long)values[i]);
+    append("]");
+  }
+};
+
+// Sink returns true only when the entire line was retained. Failure is terminal;
+// a partial line is not repaired or retried as a new JSONL record.
+using Sink = bool (*)(void*, const char*, size_t);
+
+class State {
+ public:
+  State() = default;
+  void start(const Identity& identity, Sink sink, void* arg,
+             uint64_t maxRecords = MaxRecords, uint64_t maxBytes = MaxBytes) {
+    if (started_) { fail(); return; }
+    started_ = true;
+    id_ = identity;
+    sink_ = sink;
+    sinkArg_ = arg;
+    maxRecords_ = maxRecords;
+    maxBytes_ = maxBytes;
+    enabled_ = sink != nullptr && identity.pid != 0 && identity.worker != 0 && identity.device >= 0 && identity.pollMs >= 50 && identity.staleMs >= 1000 &&
+      validToken(identity.host) && validToken(identity.boot) && validToken(identity.process) &&
+      validToken(identity.capture) && validToken(identity.build) && maxRecords > 0 &&
+      maxRecords <= MaxRecords && maxBytes >= 2 * MaxLine && maxBytes <= MaxBytes;
+  }
+  bool enabled() const { return enabled_ && !closed_; }
+  bool failed() const { return failed_; }
+  uint64_t dropped() const { return dropped_; }
+  uint64_t retained() const { return retained_; }
+  uint64_t bytes() const { return bytes_; }
+  uint64_t untracked() const { return untracked_; }
+
+  Entry* find(const void* key) {
+    for (auto& e : entries_) if (key != nullptr && e.key == key) return &e;
+    return nullptr;
+  }
+  uint64_t nextGeneration() {
+    if (!enabled() || generation_ == UINT64_MAX) return 0;
+    return ++generation_;
+  }
+  void add(const void* key, uint64_t comm, int rank, uint64_t now) {
+    if (!enabled()) return;
+    if (key == nullptr || rank < 0 || find(key) != nullptr || incarnation_ == UINT64_MAX) {
+      fail();
+      return;
+    }
+    Entry e;
+    e.key = key;
+    e.comm = comm;
+    e.rank = rank;
+    e.incarnation = ++incarnation_;
+    for (auto& slot : entries_) {
+      if (slot.key != nullptr) continue;
+      slot = e;
+      emit("registered", &slot, now, 0, nullptr);
+      return;
+    }
+    increment(untracked_);
+    emit("registration_untracked", &e, now, 0, nullptr);
+  }
+  void launch(const void* key, uint64_t generation, uint64_t start, uint64_t end, int code) {
+    Entry* e = find(key);
+    if (!enabled() || e == nullptr) return;
+    if (generation == 0 || generation != generation_ || start > end || e->pending || generation <= e->generation) {
+      fail();
+      return;
+    }
+    e->generation = generation;
+    e->launchStart = start;
+    e->launchEnd = end;
+    e->launchCode = code;
+    e->pending = code == 0;
+    e->eventRecorded = false;
+    e->stale = false;
+    emit(code == 0 ? "copy_launched" : "copy_launch_failed", e, end, code, nullptr);
+  }
+  void eventRecord(uint64_t generation, uint64_t now, int code) {
+    if (!enabled()) return;
+    for (auto& e : entries_) {
+      if (e.key == nullptr || !e.pending || e.generation != generation) continue;
+      e.eventRecorded = code == 0;
+      if (code != 0) {
+        e.pending = false;
+        emit("event_record_failed", &e, now, code, nullptr);
+      }
+    }
+  }
+  bool mayRead(const void* key, uint64_t generation) {
+    Entry* e = find(key);
+    return enabled() && e != nullptr && e->pending && e->eventRecorded &&
+      e->launchCode == 0 && !e->stale && e->generation == generation && generation != 0;
+  }
+  // snapshot is a caller-owned value copied only after this generation's event
+  // completed successfully. Encoding does not retain any array or comm pointer.
+  void complete(const void* key, uint64_t generation, uint64_t now, int code, const Snapshot* snapshot) {
+    Entry* e = find(key);
+    if (!enabled() || e == nullptr || !e->pending || e->generation != generation) return;
+    if (now >= e->launchStart && now - e->launchStart >= static_cast<uint64_t>(id_.staleMs) * 1000000ULL) e->stale = true;
+    bool fresh = code == 0 && mayRead(key, generation) && snapshot != nullptr && now >= e->launchEnd;
+    e->pending = false;
+    emit(fresh ? "copy_complete" : "copy_completion_unavailable", e, now, code, fresh ? snapshot : nullptr);
+  }
+  void pending(uint64_t generation, uint64_t now, bool stale) {
+    if (!enabled()) return;
+    for (auto& e : entries_) {
+      if (e.key != nullptr && e.pending && e.generation == generation) {
+        e.stale = e.stale || stale;
+        emit(e.stale ? "copy_pending_stale" : "copy_pending", &e, now, 0, nullptr);
+      }
+    }
+  }
+  // Removal copies identity/state only. After removal no path in State can read
+  // a communicator or its mirror; a later reused address gets a new incarnation.
+  bool remove(const void* key, uint64_t now, Entry* detached) {
+    Entry* e = find(key);
+    if (e == nullptr) return false;
+    *detached = *e;
+    detached->key = nullptr;
+    emit("unregister_requested", e, now, 0, nullptr);
+    *e = Entry{};
+    return true;
+  }
+  void drained(const Entry& detached, uint64_t now, int code) {
+    if (enabled()) emit(code == 0 ? "unregistered_drained" : "unregister_drain_failed", &detached, now, code, nullptr);
+  }
+  // This terminal says only that exporter output is closed, not that CUDA
+  // resource destruction, synchronization, or application work succeeded.
+  void finish(uint64_t now, const char* reason) {
+    if (!enabled() || closed_) return;
+    if (std::strcmp(reason, "worker_closed") != 0 && std::strcmp(reason, "initialization_failed") != 0) {
+      fail();
+      return;
+    }
+    emit(reason, nullptr, now, 0, nullptr, true);
+    closed_ = true;
+  }
+
+ private:
+  Identity id_;
+  Entry entries_[MaxComms];
+  Sink sink_ = nullptr;
+  void* sinkArg_ = nullptr;
+  uint64_t sequence_ = 0, incarnation_ = 0, generation_ = 0;
+  uint64_t retained_ = 0, dropped_ = 0, untracked_ = 0, bytes_ = 0;
+  uint64_t maxRecords_ = MaxRecords, maxBytes_ = MaxBytes;
+  bool enabled_ = false, closed_ = false, failed_ = false, started_ = false;
+
+  static bool validToken(const char (&s)[129]) {
+    char copy[129];
+    if (std::memchr(s, 0, sizeof(s)) == nullptr) return false;
+    return copyToken(copy, s);
+  }
+  void increment(uint64_t& value) {
+    if (value == UINT64_MAX) fail(); else value++;
+  }
+  void fail() { failed_ = true; enabled_ = false; }
+  void emit(const char* event, const Entry* e, uint64_t now, int code, const Snapshot* snapshot, bool terminal = false) {
+    if (!enabled()) return;
+    if (sequence_ == UINT64_MAX) { fail(); return; }
+    uint64_t sequence = ++sequence_;
+    Line line;
+    line.append("{\"schema\":\"nccl.progress-monitor.diagnostic.v1\",\"source_commit\":\"12df1a11afad322be5a204a2db890161cbf8131d\","
+      "\"build_id\":\"%s\",\"host\":\"%s\",\"boot_epoch\":\"%s\",\"process_epoch\":\"%s\",\"capture_id\":\"%s\","
+      "\"pid\":%llu,\"device\":%d,\"worker\":%llu,\"sequence\":%llu,\"event\":\"%s\",\"observed_ns\":%llu,"
+      "\"host_clock\":\"std.chrono.steady_clock\",\"gpu_clock\":\"globaltimer\",\"time_unit\":\"nanoseconds\","
+      "\"counter_unit\":\"owned_completed_work\",\"snapshot_atomic\":false,\"upstream_loss\":\"unknown\","
+      "\"poll_ms\":%d,\"stale_ms\":%d,\"max_records\":%llu,\"max_bytes\":%llu,\"terminal\":%s,"
+      "\"exporter_retained_before\":%llu,\"exporter_dropped_before\":%llu,\"untracked_registrations\":%llu,\"code\":%d",
+      id_.build, id_.host, id_.boot, id_.process, id_.capture, (unsigned long long)id_.pid, id_.device,
+      (unsigned long long)id_.worker, (unsigned long long)sequence, event, (unsigned long long)now,
+      id_.pollMs, id_.staleMs, (unsigned long long)maxRecords_, (unsigned long long)maxBytes_, terminal ? "true" : "false",
+      (unsigned long long)retained_, (unsigned long long)dropped_, (unsigned long long)untracked_, code);
+    if (e != nullptr) {
+      line.append(",\"comm_hash\":\"%016llx\",\"rank\":%d,\"registration\":%llu,\"generation\":%llu,"
+        "\"launch_start_ns\":%llu,\"launch_end_ns\":%llu,\"launch_code\":%d,\"copy_pending\":%s,"
+        "\"event_recorded\":%s,\"copy_stale\":%s,\"counter_reset\":\"unknown\"",
+        (unsigned long long)e->comm, e->rank, (unsigned long long)e->incarnation,
+        (unsigned long long)e->generation, (unsigned long long)e->launchStart,
+        (unsigned long long)e->launchEnd, e->launchCode, e->pending ? "true" : "false", e->eventRecorded ? "true" : "false", e->stale ? "true" : "false");
+    }
+    line.append(",\"mirror_present\":%s", snapshot != nullptr ? "true" : "false");
+    if (snapshot != nullptr) {
+      line.append(",\"copy_success_min_ns\":%llu,\"copy_success_max_ns\":%llu",
+        (unsigned long long)e->launchStart, (unsigned long long)now);
+      line.append(",\"completed_work_count\":"); line.array(snapshot->counts, Slots);
+      line.append(",\"completed_time_ns\":"); line.array(snapshot->gpuTimes, Slots);
+      line.append(",\"channel_active_slot_mask\":"); line.array(snapshot->active, Channels);
+    }
+    line.append("}\n");
+    if (!line.ok) { increment(dropped_); fail(); return; }
+    uint64_t reserve = terminal ? 0 : MaxLine;
+    if ((!terminal && retained_ >= maxRecords_) || bytes_ > maxBytes_ - reserve || line.size > maxBytes_ - reserve - bytes_) {
+      increment(dropped_);
+      return;
+    }
+    if (!sink_(sinkArg_, line.data, line.size)) { increment(dropped_); fail(); return; }
+    bytes_ += line.size;
+    increment(retained_);
+  }
+};
+} // namespace ncclProgressExport
