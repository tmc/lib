+
+// Each opt-in export is a new private regular file; no append, rotation or
+// overwrite. At most 64 files / 1 GiB per loaded NCCL image, and 16 MiB / file. File I/O
+// has byte/attempt bounds, not a filesystem-latency guarantee. Failure disables
+// only export. Missing terminal output means exporter coverage is unknown.
+struct ncclProgressDiagnosticExport {
+  ncclProgressExport::State state;
+  int fd;
+};
+static std::atomic<uint64_t> progressExportWorkers{0};
+
+static bool progressExportWrite(void* arg, const char* line, size_t size) {
+  auto* out = static_cast<ncclProgressDiagnosticExport*>(arg);
+  size_t done = 0;
+  for (int attempt = 0; done < size && attempt < 4; attempt++) {
+    ssize_t n = write(out->fd, line + done, size - done);
+    if (n > 0) done += static_cast<size_t>(n);
+    else if (n < 0 && errno == EINTR) continue;
+    else return false;
+  }
+  return done == size;
+}
+
+static ncclProgressDiagnosticExport* progressExportOpen(int cudaDev) {
+  const char* prefix = getenv("NCCL_PROGRESS_EXPORT_PREFIX");
+  if (prefix == nullptr || prefix[0] == 0) return nullptr; // default off
+  ncclProgressExport::Identity id;
+  if (prefix[0] != '/' || strnlen(prefix, 1025) > 1024 ||
+      !ncclProgressExport::copyToken(id.host, getenv("NCCL_PROGRESS_EXPORT_HOST")) ||
+      !ncclProgressExport::copyToken(id.boot, getenv("NCCL_PROGRESS_EXPORT_BOOT_EPOCH")) ||
+      !ncclProgressExport::copyToken(id.process, getenv("NCCL_PROGRESS_EXPORT_PROCESS_EPOCH")) ||
+      !ncclProgressExport::copyToken(id.capture, getenv("NCCL_PROGRESS_EXPORT_CAPTURE_ID")) ||
+      !ncclProgressExport::copyToken(id.build, getenv("NCCL_PROGRESS_EXPORT_BUILD_ID"))) {
+    WARN("NCCL progress export disabled: invalid explicit path or identity");
+    return nullptr;
+  }
+  // Saturating allocation of a per-image file budget, including failed opens.
+  uint64_t worker = progressExportWorkers.load();
+  do {
+    if (worker >= 64) {
+      WARN("NCCL progress export disabled: image file budget exhausted");
+      return nullptr;
+    }
+  } while (!progressExportWorkers.compare_exchange_weak(worker, worker + 1));
+  id.worker = worker + 1;
+  id.pid = static_cast<uint64_t>(getpid());
+  id.device = cudaDev;
+  id.pollMs = std::max((int)ncclParamProgressCounterMonitorPollMs(), kProgressCounterMonitorMinPollMs);
+  id.staleMs = std::max((int)ncclParamProgressCounterMonitorStaleMs(), kProgressCounterMonitorMinStaleMs);
+  char path[1152];
+  int n = snprintf(path, sizeof(path), "%s.%llu.%d.%llu.jsonl", prefix,
+                   (unsigned long long)id.pid, cudaDev, (unsigned long long)id.worker);
+  if (n < 0 || static_cast<size_t>(n) >= sizeof(path)) return nullptr;
+  int fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK, 0600);
+  if (fd < 0) {
+    WARN("NCCL progress export disabled: cannot create private output (errno %d)", errno);
+    return nullptr;
+  }
+  struct stat st;
+  if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode)) {
+    close(fd);
+    WARN("NCCL progress export disabled: output is not a regular file");
+    return nullptr;
+  }
+  auto* out = new (std::nothrow) ncclProgressDiagnosticExport{};
+  if (out == nullptr) { close(fd); return nullptr; }
+  out->fd = fd;
+  out->state.start(id, progressExportWrite, out);
+  return out;
+}
+
+static void progressExportClose(ncclProgressDiagnosticExport* out, const char* reason) {
+  if (out == nullptr) return;
+  out->state.finish(clockNano(), reason);
+  if (out->state.failed()) WARN("NCCL progress export incomplete: output or diagnostic-state failure");
+  if (close(out->fd) != 0) WARN("NCCL progress export close failed (errno %d)", errno);
+  delete out;
+}
