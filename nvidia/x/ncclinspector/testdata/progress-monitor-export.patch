+// Pure host controls for the actual production state/encoder; no CUDA headers,
+// calls, libraries, threads, files, environment access or process launches.
+#include "../src/ras/progress_monitor_export.h"
+#include <cstdlib>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+using namespace ncclProgressExport;
+static int checks;
+#define CHECK(x) do { checks++; if (!(x)) { std::cerr << "FAIL " << __func__ << ":" << __LINE__ << " " #x "\n"; std::exit(1); } } while (false)
+
+struct Output {
+  std::vector<std::string> lines;
+  bool fail = false;
+  size_t calls = 0;
+  static bool write(void* p, const char* data, size_t n) {
+    auto* out = static_cast<Output*>(p);
+    out->calls++;
+    if (out->fail) return false;
+    out->lines.emplace_back(data, n);
+    return true;
+  }
+};
+static Identity identity() {
+  Identity id;
+  CHECK(copyToken(id.host, "constructed-host"));
+  CHECK(copyToken(id.boot, "constructed-boot"));
+  CHECK(copyToken(id.process, "constructed-process"));
+  CHECK(copyToken(id.capture, "constructed-capture"));
+  CHECK(copyToken(id.build, "constructed-build"));
+  id.pid = 123;
+  id.worker = 7;
+  id.device = 0;
+  id.pollMs = 1000;
+  id.staleMs = 5000;
+  return id;
+}
+static bool has(const std::string& line, const std::string& part) { return line.find(part) != std::string::npos; }
+static bool event(const std::string& line, const char* name) { return has(line, std::string("\"event\":\"") + name + "\""); }
+static std::string expectedArray(const uint64_t* values, size_t n) {
+  std::ostringstream out;
+  out << '[';
+  for (size_t i = 0; i < n; i++) { if (i) out << ','; out << values[i]; }
+  out << ']';
+  return out.str();
+}
+static void printRows(const Output& out) {
+  for (const auto& line : out.lines) std::cout << "JSON " << line;
+}
+static void disabled_and_identity() {
+  State s; Output out; int key = 0;
+  s.add(&key, 1, 0, 1);
+  CHECK(s.nextGeneration() == 0);
+  CHECK(out.calls == 0);
+  auto id = identity();
+  id.pid = 0;
+  s.start(id, Output::write, &out);
+  CHECK(!s.enabled());
+  char token[129];
+  CHECK(!copyToken(token, "bad\"identity"));
+  CHECK(!copyToken(token, "bad\nidentity"));
+  CHECK(!copyToken(token, ""));
+  CHECK(!copyToken(token, nullptr));
+  std::string longToken(129, 'a');
+  CHECK(!copyToken(token, longToken.c_str()));
+  CHECK(copyToken(token, std::string(128, 'a').c_str()));
+}
+static void exact_success_and_copy() {
+  State s; Output out; int key = 0;
+  s.start(identity(), Output::write, &out);
+  s.add(&key, UINT64_MAX, 2, 10);
+  auto gen = s.nextGeneration();
+  s.launch(&key, gen, 20, 21, 0);
+  CHECK(!s.mayRead(&key, gen));
+  s.eventRecord(gen, 22, 0);
+  CHECK(s.mayRead(&key, gen));
+  Snapshot raw;
+  for (size_t i = 0; i < Slots; i++) { raw.counts[i] = 9007199254740993ULL + i; raw.gpuTimes[i] = UINT64_MAX - i; }
+  for (size_t i = 0; i < Channels; i++) raw.active[i] = 1ULL << (i % Slots);
+  auto wantCounts = expectedArray(raw.counts, Slots);
+  auto wantTimes = expectedArray(raw.gpuTimes, Slots);
+  auto wantMasks = expectedArray(raw.active, Channels);
+  s.complete(&key, gen, 30, 0, &raw);
+  raw.counts[0] = 0; raw.gpuTimes[0] = 0; raw.active[0] = 0;
+  const auto& line = out.lines.back();
+  CHECK(event(line, "copy_complete"));
+  CHECK(has(line, "\"comm_hash\":\"ffffffffffffffff\""));
+  CHECK(has(line, "\"completed_work_count\":" + wantCounts));
+  CHECK(has(line, "\"completed_time_ns\":" + wantTimes));
+  CHECK(has(line, "\"channel_active_slot_mask\":" + wantMasks));
+  CHECK(has(line, "\"copy_success_min_ns\":20,\"copy_success_max_ns\":30"));
+  CHECK(has(line, "\"snapshot_atomic\":false,\"upstream_loss\":\"unknown\""));
+  CHECK(!s.mayRead(&key, gen));
+  s.finish(40, "worker_closed");
+  CHECK(event(out.lines.back(), "worker_closed"));
+  CHECK(has(out.lines.back(), "\"terminal\":true"));
+  CHECK(!s.enabled());
+  printRows(out);
+}
+static void per_comm_launch_admission() {
+  State s; Output out; int a = 0, b = 0;
+  s.start(identity(), Output::write, &out);
+  s.add(&a, 17, 0, 10); s.add(&b, 17, 1, 10);
+  auto gen = s.nextGeneration();
+  s.launch(&a, gen, 20, 21, 0); s.launch(&b, gen, 20, 21, 9);
+  s.eventRecord(gen, 22, 0);
+  CHECK(s.mayRead(&a, gen));
+  CHECK(!s.mayRead(&b, gen));
+  Snapshot raw; raw.counts[0] = 91;
+  s.complete(&a, gen, 30, 0, &raw);
+  auto n = out.lines.size();
+  s.complete(&b, gen, 30, 0, &raw);
+  CHECK(out.lines.size() == n);
+  size_t complete = 0;
+  for (const auto& row : out.lines) if (event(row, "copy_complete")) { complete++; CHECK(has(row, "\"rank\":0")); }
+  CHECK(complete == 1);
+  CHECK(event(out.lines[3], "copy_launch_failed"));
+}
+static void pending_and_failures() {
+  State s; Output out; int key = 0;
+  s.start(identity(), Output::write, &out); s.add(&key, 1, 0, 1);
+  auto g = s.nextGeneration(); s.launch(&key, g, 2, 3, 0); s.eventRecord(g, 4, 0);
+  s.pending(g, 10, false); s.pending(g, 100, true);
+  CHECK(event(out.lines[out.lines.size()-2], "copy_pending"));
+  CHECK(event(out.lines.back(), "copy_pending_stale"));
+  CHECK(!has(out.lines.back(), "completed_work_count"));
+  Snapshot raw;
+  s.complete(&key, g, 101, 7, &raw);
+  CHECK(event(out.lines.back(), "copy_completion_unavailable"));
+  CHECK(!has(out.lines.back(), "completed_work_count"));
+  CHECK(!s.mayRead(&key, g));
+  auto h = s.nextGeneration(); s.launch(&key, h, 102, 103, 0); s.eventRecord(h, 104, 5);
+  CHECK(!s.mayRead(&key, h));
+  CHECK(event(out.lines.back(), "event_record_failed"));
+  auto n = out.lines.size(); s.complete(&key, h, 105, 0, &raw);
+  CHECK(out.lines.size() == n);
+  auto j = s.nextGeneration(); s.launch(&key, j, 106, 107, 0); s.eventRecord(j, 108, 0);
+  CHECK(!s.mayRead(&key, g));
+  CHECK(s.mayRead(&key, j));
+  s.complete(&key, j, 109, 0, &raw);
+  CHECK(event(out.lines.back(), "copy_complete"));
+}
+static void missing_success_evidence() {
+  for (int mode = 0; mode < 3; mode++) {
+    State s; Output out; int key = 0; Snapshot raw;
+    s.start(identity(), Output::write, &out); s.add(&key, 1, 0, 1);
+    auto g = s.nextGeneration(); s.launch(&key, g, 20, 21, 0);
+    if (mode != 0) s.eventRecord(g, 22, 0);
+    s.complete(&key, g, mode == 2 ? 19 : 30, 0, mode == 1 ? nullptr : &raw);
+    CHECK(event(out.lines.back(), "copy_completion_unavailable"));
+    CHECK(!has(out.lines.back(), "completed_work_count"));
+  }
+}
+static void successful_but_stale_copy() {
+  State s; Output out; int key = 0; Snapshot raw;
+  s.start(identity(), Output::write, &out); s.add(&key, 1, 0, 1);
+  auto g = s.nextGeneration(); s.launch(&key, g, 2, 3, 0); s.eventRecord(g, 4, 0);
+  s.complete(&key, g, 5000000002ULL, 0, &raw);
+  CHECK(event(out.lines.back(), "copy_completion_unavailable"));
+  CHECK(has(out.lines.back(), "\"copy_stale\":true"));
+  CHECK(!has(out.lines.back(), "completed_work_count"));
+}
+static void unregister_and_address_reuse() {
+  State s; Output out; int key = 0; Snapshot raw;
+  s.start(identity(), Output::write, &out); s.add(&key, 1, 0, 1);
+  auto g = s.nextGeneration(); s.launch(&key, g, 2, 3, 0); s.eventRecord(g, 4, 0);
+  Entry old;
+  CHECK(s.remove(&key, 5, &old));
+  CHECK(old.key == nullptr);
+  CHECK(!s.mayRead(&key, g));
+  s.add(&key, 1, 0, 6);
+  CHECK(s.find(&key)->incarnation != old.incarnation);
+  CHECK(!s.mayRead(&key, g));
+  auto n = out.lines.size(); s.complete(&key, g, 7, 0, &raw);
+  CHECK(out.lines.size() == n);
+  s.drained(old, 8, 9);
+  CHECK(event(out.lines.back(), "unregister_drain_failed"));
+  CHECK(has(out.lines.back(), "\"registration\":1"));
+  CHECK(!has(out.lines.back(), "completed_work_count"));
+  auto h = s.nextGeneration(); s.launch(&key, h, 10, 11, 0); s.eventRecord(h, 12, 0);
+  CHECK(s.mayRead(&key, h));
+}
+static void output_budgets_and_loss() {
+  for (bool byteCap : {false, true}) {
+    State s; Output out; int key = 0; Snapshot raw;
+    s.start(identity(), Output::write, &out, byteCap ? MaxRecords : 4, byteCap ? 2*MaxLine : MaxBytes);
+    s.add(&key, 1, 0, 1);
+    for (uint64_t i = 0; i < 100; i++) {
+      auto g = s.nextGeneration(); s.launch(&key, g, 2+i*3, 3+i*3, 0); s.eventRecord(g, 3+i*3, 0);
+      s.complete(&key, g, 4+i*3, 0, &raw);
+    }
+    CHECK(s.dropped() > 0);
+    auto dropped = s.dropped();
+    auto retained = s.retained();
+    s.finish(1000, "worker_closed");
+    CHECK(s.retained() == retained + 1);
+    CHECK(event(out.lines.back(), "worker_closed"));
+    CHECK(has(out.lines.back(), "\"exporter_dropped_before\":" + std::to_string(dropped)));
+    CHECK(s.bytes() <= (byteCap ? 2*MaxLine : MaxBytes));
+    CHECK(!has(out.lines.back(), "\"upstream_loss\":0"));
+  }
+}
+static void sink_failure_and_finality() {
+  State s; Output out; int key = 0;
+  s.start(identity(), Output::write, &out); s.add(&key, 1, 0, 1);
+  out.fail = true;
+  auto g = s.nextGeneration(); s.launch(&key, g, 2, 3, 0);
+  CHECK(s.failed()); CHECK(s.dropped() == 1);
+  auto calls = out.calls;
+  s.eventRecord(g, 4, 0); s.pending(g, 5, true); s.finish(6, "worker_closed");
+  CHECK(out.calls == calls); CHECK(!s.enabled());
+  CHECK(!event(out.lines.back(), "worker_closed"));
+}
+static void registration_bounds_and_no_restart() {
+  State s; Output out; int keys[MaxComms+1] = {};
+  s.start(identity(), Output::write, &out);
+  for (size_t i = 0; i < MaxComms+1; i++) s.add(&keys[i], 1, 0, i);
+  CHECK(s.untracked() == 1); CHECK(s.find(&keys[MaxComms]) == nullptr);
+  CHECK(event(out.lines.back(), "registration_untracked"));
+  CHECK(has(out.lines.back(), "\"untracked_registrations\":1"));
+  s.finish(200, "worker_closed");
+  auto calls = out.calls;
+  s.start(identity(), Output::write, &out);
+  CHECK(s.failed()); CHECK(!s.enabled()); CHECK(out.calls == calls);
+}
+static void duplicate_launch_refused() {
+  State s; Output out; int key = 0;
+  s.start(identity(), Output::write, &out); s.add(&key, 1, 0, 1);
+  auto g = s.nextGeneration(); s.launch(&key, g, 2, 3, 9);
+  s.launch(&key, g, 4, 5, 0);
+  CHECK(s.failed()); CHECK(!s.mayRead(&key, g));
+}
+int main() {
+  disabled_and_identity();
+  exact_success_and_copy();
+  per_comm_launch_admission();
+  pending_and_failures();
+  missing_success_evidence();
+  successful_but_stale_copy();
+  unregister_and_address_reuse();
+  output_budgets_and_loss();
+  sink_failure_and_finality();
+  registration_bounds_and_no_restart();
+  duplicate_launch_refused();
+  std::cout << "PASS " << checks << " checks in 11 groups\n";
+}
