// The workspace covers every module in this repository. A module that is not
// listed here is not built by anything, so keep this list complete.
//
// External modules are resolved through published versions or the relative
// replace directives in each go.mod. Do not add absolute host paths here.

go 1.27.0

use (
	./apple
	./examples
	./gguf
	./hf/hfsync
	./hf/hftokenizer
	./lldb
	./lm
	./nvidia
	./openxla
	./rocm
	./tpu
	./treesitter
	./x/stablehlo
	./x/xla
)
