+/* Mirrored in ds4_cuda.cu: the CUDA file cannot include this legacy header. */
+typedef struct {
+    uint32_t version;
+    uint32_t size;
+    uint32_t enabled;
+    uint32_t capacity;
+    uint32_t stride;
+    uint32_t token;
+    uint32_t head;
+    uint32_t row;
+    uint32_t dim;
+    uint32_t reserved;
+    uint64_t buffer;
+    uint64_t bytes;
+} ds4_gpu_raw_observer;
+
+typedef struct {
+    uint32_t write_index;
+    uint32_t overflow;
+} ds4_gpu_raw_observer_state;
+
+typedef struct {
+    uint32_t version;
+    uint32_t size;
+    uint32_t site;
+    uint32_t token;
+    uint32_t head;
+    uint32_t row;
+    uint32_t dim;
+    uint32_t value_bits;
+} ds4_gpu_raw_observer_record;
+
+static_assert(sizeof(ds4_gpu_raw_observer) == 56, "raw observer ABI");
+static_assert(sizeof(ds4_gpu_raw_observer_state) == 8, "raw observer state ABI");
+static_assert(sizeof(ds4_gpu_raw_observer_record) == 32, "raw observer record ABI");
+
+__device__ static void cuda_observe_raw(ds4_gpu_raw_observer o, uint32_t bits) {
+    ds4_gpu_raw_observer_state *state =
+        (ds4_gpu_raw_observer_state *)(uintptr_t)o.buffer;
+    uint32_t i = atomicAdd(&state->write_index, 0u);
+    for (;;) {
+        if (i >= o.capacity) {
+            atomicOr(&state->overflow, 1u);
+            return;
+        }
+        uint32_t prev = atomicCAS(&state->write_index, i, i + 1u);
+        if (prev == i) break;
+        i = prev;
+    }
+    ds4_gpu_raw_observer_record *r = (ds4_gpu_raw_observer_record *)
+        ((char *)state + sizeof(*state) + (uint64_t)i * o.stride);
+    r->version = 1;
+    r->size = sizeof(*r);
+    r->site = 1;
+    r->token = o.token;
+    r->head = o.head;
+    r->row = o.row;
+    r->dim = o.dim;
+    r->value_bits = bits;
+}
+
+static bool cuda_raw_observer_valid(const ds4_gpu_raw_observer *o) {
+    return o->version == 1 && o->size == sizeof(*o) && o->reserved == 0 &&
+        o->buffer != 0 && o->buffer % 4 == 0 &&
+        o->stride >= sizeof(ds4_gpu_raw_observer_record) && o->stride % 4 == 0 &&
+        o->bytes >= sizeof(ds4_gpu_raw_observer_state) &&
+        (uint64_t)o->capacity * o->stride <=
+            o->bytes - sizeof(ds4_gpu_raw_observer_state) &&
+        o->buffer <= UINT64_MAX - o->bytes;
+}
